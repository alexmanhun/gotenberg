meta {
  name: Document to PDF
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/forms/libreoffice/convert
  body: multipartForm
  auth: none
}

params:query {

}

headers {

}

body:multipart-form {
  files[]: @file(./sample.docx)
  landscape: false
  nativePageRanges: 
  exportFormFields: true
  allowDuplicateFieldNames: false
  exportBookmarks: true
  exportBookmarksToPdfDestination: false
  exportPlaceholders: false
  exportNotes: false
  exportNotesPages: false
  exportOnlyNotesPages: false
  exportNotesInMargin: false
  convertOooTargetToPdfTarget: false
  exportLinksRelativeFsys: false
  exportHiddenSlides: false
  skipEmptyPages: false
  addOriginalDocumentAsStream: false
  singlePageSheets: false
  losslessImageCompression: false
  quality: 90
  reduceImageResolution: false
  maxImageResolution: 300
  pdfUA: false
  merge: false
  metadata: 
  pdfa: 
  pdfua: false
  waitDelay: 
  waitForExpression: 
  emulatedMediaType: screen
  cookies: 
  userAgent: 
  extraHttpHeaders: 
  failOnHttpStatusCodes: [499,599]
  failOnResourceHttpStatusCodes: 
  failOnResourceLoadingFailed: false
  failOnConsoleExceptions: false
  downloadFrom: 
}

script:post-response {
  if (res.status === 200) {
    // Save the PDF response
    bru.setVar("lastConversionStatus", "success");
  } else {
    bru.setVar("lastConversionStatus", "failed");
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response is a PDF", function() {
    expect(res.headers["content-type"]).to.include("application/pdf");
  });
}
